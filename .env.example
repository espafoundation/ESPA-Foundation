# ==============================================================================
# ESPA Foundation Environment Variables Guide (Vercel & Production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MASTER DEVELOPER / MASTER ADMIN ACCOUNT (Full system access)
# ------------------------------------------------------------------------------
# Set these in Vercel to give the developer an all-access master account.
# You can log in using either this email or the username 'developer' / 'master'
# and this password at /portal or Management Login.
MASTER_ADMIN_EMAIL=developer@espafoundation.social
MASTER_ADMIN_PASSWORD=your_super_secure_developer_password_here
MASTER_ADMIN_NAME=Developer Master Admin

# ------------------------------------------------------------------------------
# 2. ORGANIZATION STANDARD ADMIN ACCOUNT
# ------------------------------------------------------------------------------
# General administrative credentials for the organization.
ADMIN_EMAIL=admin@espafoundation.social
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Admin

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# You only need to add SUPABASE_URL and SUPABASE_ANON_KEY on Vercel!
# The app automatically binds them to both serverless APIs and frontend builds,
# so you do NOT need to set separate VITE_SUPABASE_* variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Optional: Supabase Service Role Key (Server-side bypass for admin queries)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 4. EMAIL / NODEMAILER SMTP (Real-time OTPs, Notifications & Confirmations)
# ------------------------------------------------------------------------------
# Gmail SMTP configuration using your Gmail and 16-character Google App Password
EMAIL_USER=foundationespa@gmail.com
EMAIL_PASS=your_16_character_app_password

# ------------------------------------------------------------------------------
# 5. GOOGLE reCAPTCHA v2 (Form spam prevention - Optional)
# ------------------------------------------------------------------------------
# VITE_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET=
