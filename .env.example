# ==============================================================================
# ESPA Foundation Environment Variables Guide (Vercel & Local Development)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MASTER DEVELOPER / MASTER ADMIN ACCOUNT (Total access to everything)
# ------------------------------------------------------------------------------
# Set this to give the developer a dedicated master admin account.
# You can log in using either this email or the username 'developer' / 'master'
# and this password at /portal or Management Login.
MASTER_ADMIN_EMAIL=developer@espafoundation.social
MASTER_ADMIN_PASSWORD=your_super_secure_developer_password_here
MASTER_ADMIN_NAME=Developer Master Admin

# ------------------------------------------------------------------------------
# 2. ORGANIZATION STANDARD ADMIN ACCOUNT
# ------------------------------------------------------------------------------
# General administrative credentials for the organization.
ADMIN_EMAIL=admin@espafoundation.social
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Admin

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE CONFIGURATION (Server & Client)
# ------------------------------------------------------------------------------
# Found in Supabase Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (Safe for frontend & public APIs)
SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (Server-side ONLY; bypasses RLS for admin queries)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 4. EMAIL / NODEMAILER SMTP (Real-time OTPs, Notifications & Confirmations)
# ------------------------------------------------------------------------------
# Gmail SMTP configuration using a 16-character Google Account "App Password"
EMAIL_USER=foundationespa@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_APP_PASSWORD=your_16_character_app_password

# ------------------------------------------------------------------------------
# 5. OTP SECURITY SECRET (Required for 2FA verification cookies on Vercel)
# ------------------------------------------------------------------------------
# A strong random secret key used to HMAC-sign verification session cookies.
# Generate via terminal: openssl rand -hex 32
OTP_SECRET=your_random_32_byte_secret_hex_string

# ------------------------------------------------------------------------------
# 6. GOOGLE reCAPTCHA v2 (Form spam prevention)
# ------------------------------------------------------------------------------
# Public Site Key (exposed to frontend React components)
VITE_RECAPTCHA_SITE_KEY=
# Secret Key (server-side verification against Google's API)
RECAPTCHA_SECRET=

# ------------------------------------------------------------------------------
# 7. STRIPE PAYMENT GATEWAY (Donations & Checkout Sessions)
# ------------------------------------------------------------------------------
# Server secret key (starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=sk_live_...
# Frontend publishable key (starts with pk_live_ or pk_test_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ------------------------------------------------------------------------------
# 8. GENERAL RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_URL=/api
PORT=3000
DISABLE_HMR=true
